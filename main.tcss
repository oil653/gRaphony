MainApp {
    background: $background;
    height: 5;
    margin: 1; 
    min-width: 50;
    padding: 1;
}

#playbar {
    height: 3;
    width: 100%;
    background: $boost;
    content-align-horizontal: center;
}

#playbar Button {
    height: 3;
}